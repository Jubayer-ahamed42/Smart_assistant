# Google Gemini API Key (Get free from: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Facebook Page Credentials (Get from Meta Developer Portal)
# Detailed guide available in SETUP_GUIDE_BANGLA.md
FB_PAGE_ID=your_facebook_page_id_here
FB_PAGE_ACCESS_TOKEN=your_never_expiring_page_access_token_here

# Optional Configurations
# TIMEZONE defaults to Asia/Dhaka
TIMEZONE=Asia/Dhaka
